        "companyName": { "type": "string", "maxLength": 200 },
        "baseCurrency": { "type": "string", "maxLength": 12 },
        "invoicesCount": { "type": "number" },
        "vouchersCount": { "type": "number" },
        "productsCount": { "type": "number" },
        "contactsCount": { "type": "number" },
        "journalEntriesCount": { "type": "number" },
        "totalSalesBase": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "companyName", "baseCurrency", "invoicesCount", "vouchersCount", "productsCount", "contactsCount", "journalEntriesCount", "totalSalesBase", "createdAt", "updatedAt"]
    }
