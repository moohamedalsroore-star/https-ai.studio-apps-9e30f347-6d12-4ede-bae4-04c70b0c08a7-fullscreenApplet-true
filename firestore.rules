        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().tenantCode == existing().tenantCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'role', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            existing().status == 'ACTIVE' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'companyName', 'accountingAccessGranted', 'lastLoginAt', 'updatedAt'])
